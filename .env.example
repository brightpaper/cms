# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle at build time. Never a secret here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Bright Paper CMS"
NEXT_PUBLIC_APP_ENV="development"

# ---------------------------------------------------------------------------
# Server-only — read exclusively inside Route Handlers / Server Components.
# On Vercel these are set as Environment Variables, never committed.
# ---------------------------------------------------------------------------

# The deployed Apps Script Web App URL. Ends in /exec, NOT /dev.
# Apps Script editor > Deploy > New deployment > Web app > Copy the URL.
APPS_SCRIPT_URL=""

# Shared secret checked inside Apps Script so only this server can call it.
# Produced by running generateApiKey() once in the Apps Script editor; it is
# stored there under Script Properties > API_KEY. Paste the logged value here.
APPS_SCRIPT_API_KEY=""

# Optional: request timeout for Apps Script calls, in milliseconds (default 30000).
# Apps Script is slow; keep this above your largest sheet read.
APPS_SCRIPT_TIMEOUT_MS="30000"

# Signs the stateless session cookie (HMAC-SHA256). REQUIRED for login to work.
# Must be at least 32 characters; the app refuses to sign with anything weaker.
# Generate with:  openssl rand -base64 32
# Rotating this value immediately invalidates every existing session.
SESSION_SECRET=""
